# 火山引擎方舟（Ark）大模型服务配置
# API Key：在火山引擎控制台获取，请勿提交到 Git
ARK_API_KEY=your_api_key_here
# Ark API 地址（默认北京区域）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 视觉分析模型
ARK_MODEL=doubao-seed-2.0-lite

# 运行模式：online=真实调用视觉模型，demo=使用本地演示数据（演示容灾用）
APP_MODE=online

# Web 服务配置
HOST=0.0.0.0
PORT=8501

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
